# Copy this file to `.env` and fill in the values you have.
# `.env` is gitignored — never commit real secrets.
# Every value here is OPTIONAL: the pipeline runs and degrades gracefully
# without any of them (templated narrative instead of AI; written alert flag
# instead of email).

# --- Anthropic API (Phase 3: AI narrative) --------------------------------
# Without this key, narrative.py falls back to a deterministic templated summary.
ANTHROPIC_API_KEY=

# --- SMTP (Phase 4: alert emails) -----------------------------------------
# If these are unset, threshold alerts still appear in the briefing/dashboard;
# only the email send is skipped. All six are needed to actually send mail.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=
